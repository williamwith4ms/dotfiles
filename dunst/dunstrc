[global]
  follow = mouse 
  background = "#1d2021"
  frame_color = "#98971a"
  foreground = "#ebdbb2"
  font = "JetBrainsMono Nerd Font Mono 9"

[urgency_low]
  background = "#1d2021"
  frame_color = "#3c3836"
  foreground = "#a89984"

[urgency_normal]
  background = "#1d2021"
  frame_color = "#98971a"
  foreground = "#ebdbb2"

[urgency_critical]
  background = "#1d2021"
  frame_color = "#cc241d"
  foreground = "#ebdbb2"

[play_sound]
  summary = "*"
  script = ~/.config/scripts/notify_alert.sh
