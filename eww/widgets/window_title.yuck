(deflisten current_window "scripts/eww_active_window_listener.sh")

(defwidget window_title []
  (box
    :class "window_title"
    :halign "end"
    :visible {current_window != "null" && current_window != "" && current_window != " "}
    (label :text "${current_window}"
      :limit-width 30
      :show-truncated true
    )
  )
)