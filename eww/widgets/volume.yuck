(deflisten current_volume "scripts/eww_vol_listener.sh")

(defwidget volume []
  (eventbox :onscroll "~/.config/scripts/volume_control.sh {}"
  (button
      :class "volume"
      :halign "end"
      :onclick "pavucontrol &"
      :onmiddleclick "~/.config/scripts/volume_control.sh toggle"
      (label :text "${current_volume}")
    )
  )
)