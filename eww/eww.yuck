(include "widgets/index.yuck")

(defwidget bar []
  (centerbox :orientation "h"
  :class "bar"
    (left)
    (center)
    (right)
  )
)

(defwidget left []
  (box :orientation "h"
    :halign "start"
    :spacing 5
    :class "left"
    :hexpand true
    :space-evenly false
    (clock)
    (updates)
    (window_title)
  )
)

(defwidget center []
  (box :orientation "h"
    :halign "center"
    :spacing 5
    :class "center"
    :hexpand false
    :space-evenly false
    
    (workspaces)
  )
)

(defwidget right []
  (box :orientation "h"
    :halign "end"
    :spacing 10
    :class "right"
    :hexpand true
    :space-evenly false
    (media)
    (tray)
    (volume)
  )
)

(defwindow bar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "0.5%"
    :width "99%"
    :height "2%"
  :anchor "top center")
  :exclusive true
  (bar)
)

(defwindow bar1
  :monitor 1
  :windowtype "dock"
  :geometry (geometry
    :x "0%"
    :y "0.5%"
    :width "99%"
    :height "2%"
  :anchor "top center")
  :exclusive true
  (bar)
)