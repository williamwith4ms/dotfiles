(include "widgets/index.yuck")

(defwidget hzBar []
  (centerbox :orientation "h"
  :class "bar"
    (hzLeft)
    (hzCenter)
    (hzRight)
  )
)

(defwidget hzLeft []
  (box :orientation "h"
    :halign "start"
    :spacing 5
    :class "left"
    :hexpand true
    :space-evenly false
    (clock)
    ; (updates)
    (window_title)
  )
)

(defwidget hzCenter []
  (box :orientation "h"
    :halign "center"
    :spacing 5
    :class "center"
    :hexpand false
    :space-evenly false
    (workspaces)
  )
)

(defwidget hzRight []
  (box :orientation "h"
    :halign "end"
    :spacing 10
    :class "right"
    :hexpand true
    :space-evenly false
    (media)
    (tray)
    (volume)
    (battery)
  )
)

(defwidget vBar []
  (centerbox :orientation "h"
  :class "bar"
    (vLeft)
    (vCenter)
    (vRight)
  )
)

(defwidget vLeft []
  (box :orientation "h"
    :halign "start"
    :spacing 5
    :class "left"
    :hexpand true
    :space-evenly false
    (clock)
    ; (updates)
  )
)

(defwidget vCenter []
  (box :orientation "h"
    :halign "center"
    :spacing 5
    :class "center"
    :hexpand false
    :space-evenly false
    (workspaces)
  )
)

(defwidget vRight []
  (box :orientation "h"
    :halign "end"
    :spacing 10
    :class "right"
    :hexpand true
    :space-evenly false
    (tray)
    (volume)
  )
)

(defwindow hzBar1
  :monitor 1
  :windowtype "dock"
  :geometry (geometry
    :width "100%"
  :anchor "top center")
  :exclusive true
  (hzBar)
)

(defwindow hzBar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
    :width "100%"
  :anchor "top center")
  :exclusive true
  (hzBar)
)

(defwindow vBar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry
    :width "100%"
  :anchor "top center")
  :exclusive true
  (vBar)
)

